[Unit]
Description=sasahagjom (hahyn.com/p/sahak)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=heun
WorkingDirectory=/home/heun/sasahagjom
EnvironmentFile=/home/heun/sasahagjom/.env
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
